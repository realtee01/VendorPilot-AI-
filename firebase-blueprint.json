{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated SME business owner profile and session preferences stored per Firebase Auth UID.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID matching the document ID."
        },
        "businessId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Primary Business profile document ID owned by this user."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Full name of the authenticated business owner."
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 160,
          "description": "Google account email address of the user."
        },
        "businessName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140,
          "description": "Registered or trading name of the business."
        },
        "businessType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Business category or sector."
        },
        "rcNumber": {
          "type": "string",
          "minLength": 0,
          "maxLength": 40,
          "description": "Optional CAC registration or RC number."
        },
        "address": {
          "type": "string",
          "minLength": 0,
          "maxLength": 240,
          "description": "Business location or street address."
        },
        "phone": {
          "type": "string",
          "minLength": 0,
          "maxLength": 40,
          "description": "Business phone number."
        },
        "currencyCode": {
          "type": "string",
          "enum": ["NGN", "USD", "GBP", "GHS"],
          "description": "ISO currency code (default NGN)."
        },
        "currencySymbol": {
          "type": "string",
          "enum": ["₦", "$", "£", "₵"],
          "description": "Currency symbol (default ₦)."
        },
        "defaultReorderLevel": {
          "type": "number",
          "description": "Default low-stock threshold for newly added products."
        },
        "vatEnabled": {
          "type": "boolean",
          "description": "Whether VAT reporting reference is enabled."
        },
        "vatRate": {
          "type": "number",
          "description": "Standard VAT percentage."
        },
        "usageType": {
          "type": "string",
          "enum": ["business", "personal"],
          "maxLength": 20,
          "description": "Optional onboarding answer indicating business or personal usage."
        },
        "experienceLevel": {
          "type": "string",
          "enum": ["experienced", "spreadsheet", "beginner"],
          "maxLength": 24,
          "description": "Optional onboarding answer indicating prior tool experience."
        },
        "primaryGoal": {
          "type": "string",
          "enum": ["sales", "inventory", "expenses", "assistant"],
          "maxLength": 24,
          "description": "Optional onboarding answer indicating first workspace priority."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the user profile was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the user profile was last updated."
        }
      },
      "required": [
        "userId",
        "businessId",
        "name",
        "email",
        "businessName",
        "businessType",
        "rcNumber",
        "address",
        "phone",
        "currencyCode",
        "currencySymbol",
        "defaultReorderLevel",
        "vatEnabled",
        "vatRate",
        "createdAt",
        "updatedAt"
      ]
    },
    "BusinessProfile": {
      "title": "BusinessProfile",
      "description": "SME business profile document owned by an authenticated user.",
      "type": "object",
      "properties": {
        "businessId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Business document ID matching the owner UID."
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Owner Firebase Auth UID."
        },
        "businessName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140,
          "description": "Business name."
        },
        "businessCategory": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Business category or industry."
        },
        "location": {
          "type": "string",
          "minLength": 0,
          "maxLength": 240,
          "description": "Business city or physical address."
        },
        "phone": {
          "type": "string",
          "minLength": 0,
          "maxLength": 40,
          "description": "Business contact phone number."
        },
        "currencyCode": {
          "type": "string",
          "enum": ["NGN", "USD", "GBP", "GHS"],
          "description": "ISO currency code (default NGN)."
        },
        "currencySymbol": {
          "type": "string",
          "enum": ["₦", "$", "£", "₵"],
          "description": "Currency symbol (default ₦)."
        },
        "rcNumber": {
          "type": "string",
          "minLength": 0,
          "maxLength": 40,
          "description": "Optional CAC registration number."
        },
        "defaultReorderLevel": {
          "type": "number",
          "description": "Default low-stock threshold."
        },
        "vatEnabled": {
          "type": "boolean",
          "description": "VAT toggle."
        },
        "vatRate": {
          "type": "number",
          "description": "VAT percentage."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when updated."
        }
      },
      "required": [
        "businessId",
        "userId",
        "businessName",
        "businessCategory",
        "location",
        "phone",
        "currencyCode",
        "currencySymbol",
        "rcNumber",
        "defaultReorderLevel",
        "vatEnabled",
        "vatRate",
        "createdAt",
        "updatedAt"
      ]
    },
    "SaleRecord": {
      "title": "SaleRecord",
      "description": "Customer sales transaction associated with an authenticated user.",
      "type": "object",
      "properties": {
        "saleId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Unique Sale ID matching the document ID."
        },
        "orderNumber": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "description": "Human-readable order code (e.g., VP-1001)."
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Owner Firebase Auth UID."
        },
        "businessId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Associated business document ID."
        },
        "productId": {
          "type": "string",
          "minLength": 0,
          "maxLength": 128,
          "description": "Optional linked Product ID, or empty string for custom items."
        },
        "product": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "description": "Product name sold."
        },
        "quantity": {
          "type": "number",
          "description": "Units sold (must be > 0)."
        },
        "unitPrice": {
          "type": "number",
          "description": "Selling price per unit (must be > 0)."
        },
        "totalAmount": {
          "type": "number",
          "description": "Total order value (quantity * unitPrice)."
        },
        "amountPaid": {
          "type": "number",
          "description": "Amount settled so far."
        },
        "customerId": {
          "type": "string",
          "minLength": 0,
          "maxLength": 128,
          "description": "Optional linked Customer ID."
        },
        "customer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140,
          "description": "Customer name or business name."
        },
        "customerPhone": {
          "type": "string",
          "minLength": 0,
          "maxLength": 40,
          "description": "Customer phone number."
        },
        "paymentStatus": {
          "type": "string",
          "enum": ["Paid", "Pending", "Partial"],
          "description": "Settlement status of the sale."
        },
        "paymentMethod": {
          "type": "string",
          "enum": ["Bank Transfer", "POS Terminal", "Cash", "Mobile Money"],
          "description": "Payment channel used."
        },
        "date": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "Sale date in YYYY-MM-DD format."
        },
        "notes": {
          "type": "string",
          "minLength": 0,
          "maxLength": 300,
          "description": "Optional delivery or order notes."
        },
        "stockDeductedQty": {
          "type": "number",
          "description": "Exact units already deducted from linked product stock to prevent duplicate deductions."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when recorded."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when last updated."
        }
      },
      "required": [
        "saleId",
        "orderNumber",
        "userId",
        "businessId",
        "productId",
        "product",
        "quantity",
        "unitPrice",
        "totalAmount",
        "amountPaid",
        "customerId",
        "customer",
        "customerPhone",
        "paymentStatus",
        "paymentMethod",
        "date",
        "notes",
        "stockDeductedQty",
        "createdAt",
        "updatedAt"
      ]
    },
    "ExpenseRecord": {
      "title": "ExpenseRecord",
      "description": "Operational business expense associated with an authenticated user.",
      "type": "object",
      "properties": {
        "expenseId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Unique Expense ID matching the document ID."
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Owner Firebase Auth UID."
        },
        "businessId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Associated business document ID."
        },
        "category": {
          "type": "string",
          "enum": [
            "Inventory Restock",
            "Logistics & Delivery",
            "Power & Generator Fuel",
            "Rent & Utilities",
            "Staff Salaries",
            "Marketing & Ads",
            "Packaging & Supplies"
          ],
          "description": "Expense category."
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "description": "Expense summary description."
        },
        "vendor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140,
          "description": "Vendor or payee name."
        },
        "amount": {
          "type": "number",
          "description": "Expense amount (must be > 0)."
        },
        "paymentMethod": {
          "type": "string",
          "enum": ["Bank Transfer", "POS Terminal", "Cash", "Mobile Money"],
          "description": "Payment channel used."
        },
        "date": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "Expense date in YYYY-MM-DD format."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when recorded."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when last updated."
        }
      },
      "required": [
        "expenseId",
        "userId",
        "businessId",
        "category",
        "description",
        "vendor",
        "amount",
        "paymentMethod",
        "date",
        "createdAt",
        "updatedAt"
      ]
    },
    "ProductItem": {
      "title": "ProductItem",
      "description": "Product inventory item owned by an authenticated user.",
      "type": "object",
      "properties": {
        "productId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Unique Product ID matching the document ID."
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Owner Firebase Auth UID."
        },
        "businessId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Associated business document ID."
        },
        "sku": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "description": "Stock Keeping Unit identifier."
        },
        "productName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "description": "Display name of the product."
        },
        "category": {
          "type": "string",
          "enum": [
            "Grains & Staples",
            "Cooking Oils",
            "Beverages & Dairy",
            "Packaged Foods",
            "Household Essentials"
          ],
          "description": "Product category."
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30,
          "description": "Measurement unit (e.g., Bag, Carton, Keg)."
        },
        "costPrice": {
          "type": "number",
          "description": "Unit purchase cost (>= 0)."
        },
        "sellingPrice": {
          "type": "number",
          "description": "Unit selling price (> 0)."
        },
        "quantity": {
          "type": "number",
          "description": "Available stock count (>= 0)."
        },
        "lowStockThreshold": {
          "type": "number",
          "description": "Reorder alert level (>= 0)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when product was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when product was last updated."
        }
      },
      "required": [
        "productId",
        "userId",
        "businessId",
        "sku",
        "productName",
        "category",
        "unit",
        "costPrice",
        "sellingPrice",
        "quantity",
        "lowStockThreshold",
        "createdAt",
        "updatedAt"
      ]
    },
    "CustomerRecord": {
      "title": "CustomerRecord",
      "description": "Customer profile associated with an authenticated user's business.",
      "type": "object",
      "properties": {
        "customerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Unique Customer ID matching the document ID."
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Owner Firebase Auth UID."
        },
        "businessId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Associated business document ID."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140,
          "description": "Customer full name or store name."
        },
        "phone": {
          "type": "string",
          "minLength": 0,
          "maxLength": 40,
          "description": "Customer contact phone number."
        },
        "email": {
          "type": "string",
          "minLength": 0,
          "maxLength": 160,
          "description": "Optional customer email address."
        },
        "totalOrders": {
          "type": "number",
          "description": "Count of orders recorded for this customer (>= 0)."
        },
        "totalSpent": {
          "type": "number",
          "description": "Cumulative order spend for this customer (>= 0)."
        },
        "lastOrderDate": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "Date of most recent order (YYYY-MM-DD)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when last updated."
        }
      },
      "required": [
        "customerId",
        "userId",
        "businessId",
        "name",
        "phone",
        "email",
        "totalOrders",
        "totalSpent",
        "lastOrderDate",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private SME owner account profile; strictly restricted to the owning UID."
    },
    "/businesses/{businessId}": {
      "schema": { "$ref": "#/entities/BusinessProfile" },
      "description": "Business profile document (name, category, location, phone, currency) restricted to the owning UID."
    },
    "/sales/{saleId}": {
      "schema": { "$ref": "#/entities/SaleRecord" },
      "description": "Customer sales orders scoped by userId with atomic stock-deduction tracking."
    },
    "/expenses/{expenseId}": {
      "schema": { "$ref": "#/entities/ExpenseRecord" },
      "description": "Operational business expenses scoped by userId."
    },
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/ProductItem" },
      "description": "Product catalogue and stock quantities scoped by userId."
    },
    "/customers/{customerId}": {
      "schema": { "$ref": "#/entities/CustomerRecord" },
      "description": "Business customer directory records scoped by userId."
    }
  }
}
